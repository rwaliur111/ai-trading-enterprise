# Update .gitignore
@'
# Dependencies
node_modules/
.npm
.pnpm
.yarn/
.yarn.lock

# Next.js
.next/
out/

# Production
build/
dist/

# Environment
.env.local
.env.production.local
.env.development.local
.env.test.local
.env
*.env
.env.*.local

# Logs
*.log
logs/

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Docker
docker-data/
*.dockerignore

# Testing
playwright-report/
test-results/

# Vercel
.vercel/

# Temporary files
tmp/
temp/

# Database
*.db
*.sqlite
*.sqlite3

# Keys
*.pem
*.key
*.crt

# Backup files
*.backup
*backup*
backup/

# Scripts with API keys (exclude specific files)
deploy-real.ps1
vercel-deploy.ps1
master-deploy.ps1

# Misc
*.tgz
*.tar.gz
'@ | Set-Content -Path ".gitignore" -Encoding UTF8

Write-Host "Updated .gitignore" -ForegroundColor Green